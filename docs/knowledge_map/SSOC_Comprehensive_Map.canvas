{
  "nodes": [
    {"id":"title","type":"text","text":"# نقشهٔ جامع SSOC\nنمای واقعی مخزن در شاخهٔ agent/obsidian-knowledge-map\n\nاین نقشه «فهم عمومی» را ادعا نمی‌کند؛ پژوهش، شواهد، کد و مرز ادعا را جدا نشان می‌دهد.","x":0,"y":-520,"width":620,"height":230,"color":"6"},
    {"id":"archive","type":"text","text":"# ۱. آرشیو پژوهش خام\n۱۰ Notebook + aristotle_logic.py\n\nحفظ می‌شود؛ حذف یا بازنویسی نمی‌شود.\nمنبعِ پرسش‌ها، ایده‌ها و مسیرهای اولیه است.","x":0,"y":-170,"width":360,"height":220,"color":"5"},
    {"id":"inventory","type":"file","file":"docs/inventory/README.md","x":460,"y":-170,"width":370,"height":230,"color":"3"},
    {"id":"topics","type":"file","file":"docs/inventory/topic_map.md","x":930,"y":-300,"width":390,"height":230,"color":"4"},
    {"id":"risks","type":"file","file":"docs/inventory/contradictions_and_risks.md","x":930,"y":0,"width":390,"height":230,"color":"1"},
    {"id":"question","type":"file","file":"docs/knowledge_map/internal_map_meaning.md","x":1430,"y":-300,"width":430,"height":230,"color":"6"},
    {"id":"research-boundary","type":"text","text":"# پرسش پژوهشی\n«فهم و شکل‌گیری معنا»\n\nمفاهیم فلسفی، دینی و روان‌شناختی در آرشیو می‌مانند؛ فقط صورت‌بندی دقیق و آزمون‌پذیر وارد هستهٔ مهندسی می‌شود.","x":1430,"y":0,"width":430,"height":250,"color":"5"},
    {"id":"strategy","type":"file","file":"docs/knowledge_map/rational_core_strategy.md","x":1970,"y":-150,"width":430,"height":230,"color":"4"},
    {"id":"v01spec","type":"file","file":"specs/rational_core_v0_1.md","x":2510,"y":-360,"width":400,"height":220,"color":"3"},
    {"id":"v01idea","type":"text","text":"# هستهٔ ۰٫۱: تناقض محدود\nورودی گزاره: موضوع، رابطه، محمول، زمان، زمینه، قطبیت و منشأ\n\nخروجی: سازگار / متناقض / نامعین\n\nزمان یا زمینهٔ متفاوت، تناقض کاذب نمی‌سازد.","x":2510,"y":-80,"width":400,"height":260,"color":"6"},
    {"id":"code","type":"file","file":"src/rational_core/core.py","x":3020,"y":-360,"width":390,"height":220,"color":"2"},
    {"id":"api","type":"text","text":"# سطح اجرا\nPython package\nCLI + API\nخروجی JSON ساختاریافته\n\nفایل‌های مرتبط:\nsrc/rational_core/cli.py\nsrc/rational_core/model.py","x":3020,"y":-80,"width":390,"height":220,"color":"2"},
    {"id":"tests","type":"file","file":"tests/fixtures/contradiction_cases.json","x":3020,"y":220,"width":390,"height":220,"color":"3"},
    {"id":"experiment","type":"file","file":"docs/experiments/experiment_01_result.md","x":3530,"y":-140,"width":440,"height":250,"color":"4"},
    {"id":"result","type":"text","text":"# نتیجهٔ کنترل‌شده\nهسته: ۱۲ از ۱۲\nخط پایهٔ بدون زمان/زمینه: ۸ از ۱۲\n\n۹ آزمون نرم‌افزاری، CLI و API موفق.\nاین فقط دربارهٔ همین جهان کوچک و ۱۲ سناریوست.","x":3530,"y":180,"width":440,"height":250,"color":"3"},
    {"id":"limits","type":"text","text":"# مرز ادعا\nاثبات نشده: فهم عمومی، یادگیریِ قاعده، فطرت، خودآگاهی یا شناخت انسانی.\n\nقاعدهٔ تناقض را ما صریحاً نوشته‌ایم؛ سیستم آن را کشف نکرده است.","x":4070,"y":-140,"width":430,"height":250,"color":"1"},
    {"id":"next","type":"text","text":"# قدم بعدِ معتبر\n۱. استخراج ادعاهای آرشیو با شناسه و منشأ\n۲. راستی‌آزمایی منابعِ اثرگذار بر معماری\n۳. انتخاب و آزمون یک مسیر بعدی: وجود/عدم یا کل/جزء\n\nبدون ادعای جهش به «فهم کامل».","x":4070,"y":180,"width":430,"height":270,"color":"6"},
    {"id":"continuity","type":"file","file":"docs/knowledge_map/project_continuity.md","x":0,"y":430,"width":410,"height":230,"color":"5"},
    {"id":"branches","type":"text","text":"# وضعیت شاخه‌ها\nmain: پایهٔ قدیمی PR\nagent/content-inventory-phase-1-2: شاخهٔ فعالِ پیشین\nagent/obsidian-knowledge-map: نقشهٔ فعلی\narchive/*: نقاط بازیابی؛ حذف نشوند.","x":520,"y":430,"width":430,"height":240,"color":"5"},
    {"id":"sync","type":"file","file":"docs/knowledge_map/OBSIDIAN_SYNC.md","x":1060,"y":430,"width":410,"height":230,"color":"2"},
    {"id":"stale","type":"text","text":"# هشدار مستندی\nresearch_dashboard.md بخشی از وضعیت پیش از اجرای ۰٫۱ را نشان می‌دهد و با کد/آزمون فعلی همگام نیست.\n\nآن را شاهد وضعیت نهایی ندان؛ باید در گام مستندسازی بعدی اصلاح شود.","x":1580,"y":430,"width":470,"height":230,"color":"1"}
